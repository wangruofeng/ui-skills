{
  "name": "ui-skills",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://ui-skills.wangruofeng007.com"
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "ui-skills-auth",
      "database_id": "11a387fa-6c54-4208-8f37-109622f1ca8d",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "preview": {
      "vars": {
        "BETTER_AUTH_URL": ""
      },
      "d1_databases": []
    }
  }
}
