---
import { topicBySlug } from "../data/topics";
import type { TopicSlug } from "../data/registry";
import { agents } from "../data/agents";
import { playbook } from "../data/playbook";
import { collections } from "../data/collections";
import { skills } from "../data/skills";

const currentYear = new Date().getFullYear();
const footerTopicSlugs: TopicSlug[] = [
  "accessibility",
  "motion",
  "systems",
  "visual",
  "interaction",
  "performance",
];
const featuredTopics = footerTopicSlugs
  .map((slug) => topicBySlug.get(slug))
  .filter((topic): topic is NonNullable<typeof topic> => Boolean(topic));
const featuredAgentIds = [
  "claude-code",
  "cursor",
  "openclaw",
  "codex",
  "github-copilot",
  "opencode",
];
const featuredAgents = featuredAgentIds
  .map((id) => agents.find((agent) => agent.id === id))
  .filter((agent): agent is NonNullable<typeof agent> => Boolean(agent));
const footerPlaybookEntries = [
  { slug: "reserve-space-with-aspect-ratio", label: "Prevent layout shifts" },
  { slug: "use-text-balance", label: "Balance headings" },
  { slug: "use-tabular-nums-for-data", label: "Tabular numbers" },
  { slug: "use-large-touch-targets", label: "Large touch targets" },
  { slug: "show-visible-focus-rings", label: "Visible focus rings" },
  { slug: "label-every-form-field", label: "Label form fields" },
];
const playbookSlugs = new Set(playbook.map((entry) => entry.slug));
const featuredPlaybook = footerPlaybookEntries.filter((entry) =>
  playbookSlugs.has(entry.slug),
);
const footerSkillPaths = [
  "ibelick/ui-skills-root",
  "ibelick/improve-ui",
  "ibelick/component-canvas",
  "wheresryan22/anatomy",
  "0xdesign/design-lab",
  "emilkowalski/improve-animations",
];
const skillByPath = new Map(skills.map((skill) => [skill.pathSlug, skill]));
const featuredSkills = footerSkillPaths
  .map((path) => skillByPath.get(path))
  .filter((skill): skill is NonNullable<typeof skill> => Boolean(skill));
const footerCollectionSlugs = [
  "mobile-app-design",
  "website-layout",
  "visual-hierarchy",
  "design-principles",
  "landing-page-design",
  "button-design",
];
const collectionBySlug = new Map(
  collections.map((collection) => [collection.slug, collection]),
);
const footerCollections = footerCollectionSlugs
  .map((slug) => collectionBySlug.get(slug))
  .filter((collection): collection is NonNullable<typeof collection> =>
    Boolean(collection),
  );
type FooterLink = {
  label: string;
  href: string;
  external?: boolean;
};

type FooterSection = {
  title: string;
  links: FooterLink[];
  more?: FooterLink;
};

const navSections: FooterSection[] = [
  {
    title: "Discover",
    links: [
      { label: "Skills", href: "/skills" },
      { label: "New skills", href: "/skills/new" },
      { label: "Topics", href: "/skills/topics" },
      { label: "Collections", href: "/collections" },
      { label: "Authors", href: "/authors" },
    ],
  },
  {
    title: "Resources",
    links: [
      { label: "Components", href: "/components" },
      { label: "Design systems", href: "/design-systems" },
      { label: "Icons", href: "/icons" },
      { label: "Design.md", href: "/design-md" },
      { label: "Playbook", href: "/playbook" },
    ],
  },
  {
    title: "Community",
    links: [
      { label: "Agents", href: "/agents" },
      { label: "Jobs", href: "/jobs" },
      { label: "Post a job", href: "/jobs/post" },
      { label: "Sponsor", href: "/sponsor" },
      {
        label: "GitHub",
        href: "https://github.com/wangruofeng/ui-skills",
        external: true,
      },
      { label: "X", href: "https://x.com/ibelick", external: true },
    ],
  },
  {
    title: "Developers",
    links: [
      { label: "CLI", href: "/cli" },
      { label: "MCP", href: "/mcp/docs" },
      { label: "Registry", href: "/skills/registry.txt" },
      { label: "llms.txt", href: "/llms.txt" },
    ],
  },
];

const discoverySections: FooterSection[] = [
  {
    title: "Topics",
    links: featuredTopics.map((topic) => ({
      label: topic.label,
      href: `/skills/${topic.slug}`,
    })),
    more: { label: "All topics", href: "/skills/topics" },
  },
  {
    title: "Collections",
    links: footerCollections.map((collection) => ({
      label: collection.title,
      href: `/collections/${collection.slug}`,
    })),
    more: { label: "All collections", href: "/collections" },
  },
  {
    title: "Agents",
    links: featuredAgents.map((agent) => ({
      label: agent.name,
      href: `/agents/${agent.id}`,
    })),
    more: { label: "All agents", href: "/agents" },
  },
  {
    title: "Popular skills",
    links: featuredSkills.map((skill) => ({
      label: skill.label,
      href: `/skills/${skill.pathSlug}`,
    })),
    more: { label: "All skills", href: "/skills" },
  },
  {
    title: "Playbook",
    links: featuredPlaybook.map((entry) => ({
      label: entry.label,
      href: `/playbook/${entry.slug}`,
    })),
    more: { label: "All guides", href: "/playbook" },
  },
];

const footerColumns = [
  [navSections[0], discoverySections[0]],
  [navSections[1], discoverySections[1]],
  [discoverySections[2], discoverySections[3]],
  [navSections[2], navSections[3]],
  [discoverySections[4]],
];
const linkClass =
  "text-content-secondary hover:text-content-primary focus-visible:outline-content-primary block w-fit max-w-full break-words rounded py-1 hover:underline focus-visible:outline-1 focus-visible:outline-offset-2";
---

<footer id="site-footer" class="bg-surface-subtle mt-24 sm:mt-32">
  <div class="footer-content type-body-sm mx-auto w-full max-w-5xl">
    <div
      class="border-line-default flex flex-col gap-3 border-b py-6 sm:flex-row sm:items-center sm:gap-6"
    >
      <a
        href="/"
        class="text-content-primary inline-flex shrink-0 items-center gap-2 font-medium"
      >
        <img
          src="/uiskills-logo-light.webp"
          alt=""
          aria-hidden="true"
          class="size-4"
          width="16"
          height="16"
        />
        <span>UI Skills</span>
      </a>
      <p class="text-content-secondary max-w-md text-pretty">
        Curated skills, guides, and resources for building better interfaces
        with agents.
      </p>
    </div>

    <nav
      aria-label="Footer navigation"
      class="footer-directory grid md:grid-cols-5 md:gap-8 md:py-6"
    >
      {
        footerColumns.map((column) => (
          <div class="min-w-0 md:space-y-6">
            {column.map((section) => (
              <details class="footer-section" open>
                <summary class="text-content-primary flex list-none items-center justify-between gap-4 font-medium">
                  <span>{section.title}</span>
                  <svg
                    class="footer-chevron size-3 shrink-0 md:hidden"
                    viewBox="0 0 12 12"
                    fill="none"
                    aria-hidden="true"
                  >
                    <path
                      d="m3 4.5 3 3 3-3"
                      stroke="currentColor"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </summary>
                <ul class="pb-4 pl-2 md:mt-2 md:pb-0 md:pl-0">
                  {section.links.map((link) => (
                    <li>
                      <a
                        href={link.href}
                        target={link.external ? "_blank" : undefined}
                        rel={link.external ? "noopener noreferrer" : undefined}
                        class={linkClass}
                      >
                        {link.label}
                      </a>
                    </li>
                  ))}
                  {section.more && (
                    <li class="pt-1">
                      <a href={section.more.href} class={linkClass}>
                        {section.more.label}
                      </a>
                    </li>
                  )}
                </ul>
              </details>
            ))}
          </div>
        ))
      }
    </nav>

    <div class="text-content-secondary py-5 md:pt-3">
      <p class="text-right leading-relaxed text-pretty">
        <span class="block"
          >Independent open-source mirror by <a
            class="text-content-primary underline underline-offset-2"
            href="https://github.com/wangruofeng/ui-skills">wangruofeng</a
          >.</span
        >
        <span class="block"
          >Based on <a
            class="text-content-primary underline underline-offset-2"
            href="https://github.com/ibelick/ui-skills"
            >Julien Thibeaut’s UI Skills</a
          > · MIT. <span>Skill content remains in its original language.</span></span
        >
      </p>
    </div>
    <div
      class="border-line-default text-content-secondary flex flex-wrap items-center justify-between gap-x-6 gap-y-3 border-t py-4"
    >
      <p>©{currentYear} UI Skills</p>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
        <a
          href="https://github.com/wangruofeng/ui-skills"
          class="hover:text-content-primary hover:underline">GitHub</a
        >
        <span class="bg-line-default h-3 w-px" aria-hidden="true"></span>
        <a
          href="https://github.com/wangruofeng/ui-skills/blob/main/LICENSE"
          class="hover:text-content-primary hover:underline">MIT</a
        >
        <span class="bg-line-default h-3 w-px" aria-hidden="true"></span>
        <a
          href="/sitemap.xml"
          class="hover:text-content-primary hover:underline">Sitemap</a
        >
      </div>
    </div>
  </div>
</footer>

<script>
  const desktopFooter = window.matchMedia("(min-width: 768px)");
  const sections = document.querySelectorAll<HTMLDetailsElement>(
    "#site-footer .footer-section",
  );
  function syncFooterSections() {
    sections.forEach((section) => {
      section.open = desktopFooter.matches;
      const summary = section.querySelector("summary");
      if (summary) summary.tabIndex = desktopFooter.matches ? -1 : 0;
    });
  }
  syncFooterSections();
  desktopFooter.addEventListener("change", syncFooterSections);
</script>

<style>
  .footer-content {
    padding-inline: clamp(1.5rem, 4vw, 3rem);
  }
  .footer-section summary::-webkit-details-marker {
    display: none;
  }
  @media (max-width: 767px) {
    .footer-section {
      border-bottom: 1px solid var(--color-line-default);
    }
    .footer-section summary {
      padding-block: 0.875rem;
      cursor: pointer;
    }
    .footer-section[open] .footer-chevron {
      transform: rotate(180deg);
    }
  }
  @media (min-width: 768px) {
    .footer-section summary {
      pointer-events: none;
    }
  }
</style>
